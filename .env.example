# Prioritize — local development environment template
# Copy to .env and fill in values. Never commit real secrets.

# PostgreSQL
# Local (JDK/npm on host): POSTGRES_HOST=localhost
# Docker Compose: compose sets POSTGRES_HOST=db for the backend service (do not override to localhost there)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=prioritize
POSTGRES_USER=prioritize
POSTGRES_PASSWORD=change_me

# Spring Boot
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
JWT_SECRET=replace_with_long_random_secret_at_least_32_chars
JWT_EXPIRATION_MS=86400000
APP_CORS_ORIGINS=http://localhost:4200

# Google OAuth 2.0 / OpenID Connect
# Create an OAuth client (Web application) in Google Cloud Console.
# Authorized redirect URI: http://localhost:8080/login/oauth2/code/google
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_OAUTH_SUCCESS_REDIRECT=http://localhost:4200/auth/callback

# Frontend
API_BASE_URL=http://localhost:8080

# Twilio SMS (optional — not required for local MVP; placeholders for a later reminders channel)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
