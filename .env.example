# Prioritize — local development environment template
# Copy to .env and fill in values. Never commit real secrets.

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=prioritize
POSTGRES_USER=prioritize
POSTGRES_PASSWORD=change_me

# Spring Boot
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
JWT_SECRET=replace_with_long_random_secret_at_least_32_chars
JWT_EXPIRATION_MS=86400000
APP_CORS_ORIGINS=http://localhost:4200

# Google OAuth 2.0 / OpenID Connect
# Create an OAuth client (Web application) in Google Cloud Console.
# Authorized redirect URI: http://localhost:8080/login/oauth2/code/google
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_OAUTH_SUCCESS_REDIRECT=http://localhost:4200/auth/callback

# Canvas LMS (development — personal access token; OAuth later)
# Set CANVAS_MOCK_ENABLED=true to sync sample courses without a real Canvas token.
CANVAS_BASE_URL=https://your-school.instructure.com
CANVAS_API_TOKEN=
CANVAS_MOCK_ENABLED=false

# Frontend
API_BASE_URL=http://localhost:8080
