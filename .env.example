# Prioritize — local development environment template
# Copy to .env and fill in values. Never commit real secrets.

# PostgreSQL
# Local (JDK/npm on host): POSTGRES_HOST=localhost, POSTGRES_PORT=5432 (or 5433 if you map compose that way)
# Docker Compose: backend uses hostname `db` on port 5432 inside the network
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_PUBLISHED_PORT=5433
POSTGRES_DB=prioritize
POSTGRES_USER=prioritize
POSTGRES_PASSWORD=change_me

# Spring Boot
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
JWT_SECRET=replace_with_long_random_secret_at_least_32_chars
JWT_EXPIRATION_MS=86400000
APP_CORS_ORIGINS=http://localhost:4200

# Production public URL (used by deploy-ec2.ps1 for EC2 OAuth/CORS; leave blank for local-only)
APP_PUBLIC_URL=https://theprioritize.com
# Elastic IP to re-attach after each deploy-ec2.ps1 -Replace (optional)
PRIORITIZE_ELASTIC_IP=

# Google OAuth 2.0 / OpenID Connect
# Local redirect: http://localhost:8080/login/oauth2/code/google
# Prod redirect:  https://theprioritize.com/login/oauth2/code/google
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_OAUTH_SUCCESS_REDIRECT=http://localhost:4200/auth/callback
SPRING_AUTOCONFIGURE_EXCLUDE=

# Canvas LMS
# Mock mode: sample data without school credentials.
# Real school: set CANVAS_MOCK_ENABLED=false and either a personal token OR OAuth developer key.
CANVAS_BASE_URL=https://your-school.instructure.com
CANVAS_API_TOKEN=
CANVAS_MOCK_ENABLED=true
CANVAS_OAUTH_CLIENT_ID=
CANVAS_OAUTH_CLIENT_SECRET=
CANVAS_OAUTH_REDIRECT_URI=http://localhost:8080/api/canvas/oauth/callback
APP_CANVAS_OAUTH_SUCCESS_REDIRECT=http://localhost:4200/dashboard

# Frontend
API_BASE_URL=http://localhost:8080
FRONTEND_PUBLISHED_PORT=4200

# Email reminders (SMTP — Mailpit/Mailhog on 1025 for local dev)
NOTIFICATIONS_EMAIL_ENABLED=false
NOTIFICATIONS_EMAIL_FROM=noreply@prioritize.app
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false

# SMS reminders (Twilio)
NOTIFICATIONS_SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# AI assistant (OpenAI-compatible API — key stays on the server)
# deploy-ec2.ps1 reads these for production EC2 (not committed; keep in local .env only)
# For local Ollama: AI_ENABLED=true, AI_API_KEY=ollama, AI_BASE_URL=http://localhost:11434/v1
AI_ENABLED=false
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_WARMUP_ENABLED=true
AI_KEEP_ALIVE=30m
